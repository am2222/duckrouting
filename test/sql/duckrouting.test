# name: test/sql/duckrouting.test
# description: test duckrouting extension loading and registration
# group: [duckrouting]

# Before we load the extension, this will fail
statement error
SELECT duckrouting_version('Sam');
----
Catalog Error: Scalar Function with name duckrouting_version does not exist!

# Require statement will ensure this test is run with this extension loaded
require duckrouting

query I
SELECT duckrouting_version('Sam') ILIKE 'Duckrouting Sam, built against Boost %';
----
true

# Every routing function is registered. The count is the number of overloads:
# scalar and array vertex arguments, with and without trailing flags.
query TI
SELECT function_name, count(*) FROM duckdb_functions()
WHERE function_name LIKE 'duckrouting_%' AND function_type = 'table'
GROUP BY function_name ORDER BY function_name;
----
duckrouting_articulation_points	1
duckrouting_astar	8
duckrouting_astar_cost	8
