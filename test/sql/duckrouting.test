# name: test/sql/duckrouting.test
# description: test duckrouting extension loading and registration
# group: [duckrouting]

# Before we load the extension, this will fail
statement error
SELECT duckrouting_version('Sam');
----
Catalog Error: Scalar Function with name duckrouting_version does not exist!

# Require statement will ensure this test is run with this extension loaded
require duckrouting

query I
SELECT duckrouting_version('Sam') ILIKE 'Duckrouting Sam, built against Boost %';
----
true

# Every routing function is registered, each with overloads for scalar and
# array vertex arguments, with and without the trailing `directed` flag.
query TI
SELECT function_name, count(*) FROM duckdb_functions()
WHERE function_name LIKE 'duckrouting_%' AND function_type = 'table'
GROUP BY function_name ORDER BY function_name;
----
duckrouting_articulation_points	1
duckrouting_biconnected_components	1
duckrouting_bridges	1
duckrouting_connected_components	1
duckrouting_dijkstra	8
duckrouting_dijkstra_cost	8
duckrouting_dijkstra_cost_matrix	2
duckrouting_dijkstra_near	8
duckrouting_dijkstra_near_cost	8
duckrouting_dijkstra_via	4
duckrouting_driving_distance	4
duckrouting_floyd_warshall	2
duckrouting_johnson	2
duckrouting_kruskal	1
duckrouting_kruskal_bfs	4
duckrouting_kruskal_dd	2
duckrouting_kruskal_dfs	4
duckrouting_ksp	8
duckrouting_make_connected	1
duckrouting_prim	1
duckrouting_prim_bfs	4
duckrouting_prim_dd	2
duckrouting_prim_dfs	4
duckrouting_strong_components	1
