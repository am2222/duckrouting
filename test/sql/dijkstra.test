# name: test/sql/dijkstra.test
# description: duckrouting_dijkstra checked against pgRouting's own expected output
# group: [sql]

#
# The edge table is pgRouting's canonical sample network (tools/testers/sampledata.pg),
# with source/target resolved to the values pgRouting's docs publish, so no PostGIS is
# needed. Expected results are copied from pgRouting's docqueries/dijkstra/dijkstra.result
# and pgtap/dijkstra/dijkstra/edge_cases/. The query label in each comment (q70, q90, ...)
# is pgRouting's own label for that case.
#
# Note the one-way encoding: a negative cost means the edge does not exist in that
# direction. Edge 2 (6->10) has cost -1, so a directed route from 6 to 10 must detour,
# while an undirected route may use it via reverse_cost.

require duckrouting

statement ok
CREATE TABLE edges(id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
 (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
 (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
 (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

# ---------------------------------------------------------------------------
# Directed, with reverse_cost
# ---------------------------------------------------------------------------

# pgRouting q70: 6 -> 10. Edge 2 is one-way against us, so the route detours
# through 7, 11, 16, 15.
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 6, 10);
----
1	1	6	10	6	4	1	0
2	2	6	10	7	8	1	1
3	3	6	10	11	9	1	2
4	4	6	10	16	16	1	3
5	5	6	10	15	3	1	4
6	6	6	10	10	-1	0	5

# pgRouting q71: 6 -> 7
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 6, 7);
----
1	1	6	7	6	4	1	0
2	2	6	7	7	-1	0	1

# pgRouting q72: 12 -> 10
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 12, 10);
----
1	1	12	10	12	13	1	0
2	2	12	10	17	15	1	1
3	3	12	10	16	16	1	2
4	4	12	10	15	3	1	3
5	5	12	10	10	-1	0	4

# pgRouting q73: 12 -> 7
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 12, 7);
----
1	1	12	7	12	13	1	0
2	2	12	7	17	15	1	1
3	3	12	7	16	9	1	2
4	4	12	7	11	8	1	3
5	5	12	7	7	-1	0	4

# ---------------------------------------------------------------------------
# Undirected, with reverse_cost
# ---------------------------------------------------------------------------

# pgRouting q90: 6 -> 10 undirected now takes edge 2 directly, at reverse_cost 1.
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 6, 10, false);
----
1	1	6	10	6	2	1	0
2	2	6	10	10	-1	0	1

# pgRouting q91: 6 -> 7 undirected
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 6, 7, false);
----
1	1	6	7	6	4	1	0
2	2	6	7	7	-1	0	1

# pgRouting q92: 12 -> 10 undirected
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 12, 10, false);
----
1	1	12	10	12	11	1	0
2	2	12	10	11	5	1	1
3	3	12	10	10	-1	0	2

# pgRouting q93: 12 -> 7 undirected.
# KNOWN TIE: two shortest paths cost exactly 2 here -- 12-(e12)->8-(e10)->7, which
# pgRouting reports, and 12-(e11)->11-(e8)->7, which Boost reports. Dijkstra does
# not define which equal-cost path wins, so we assert only what is determinate:
# the hop count, the endpoints, and the total cost.
query IIIR
SELECT count(*), min(start_vid), min(end_vid), max(agg_cost)
FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 12, 7, false);
----
3	12	7	2

# The tie-broken path must still be a real path: every reported edge exists and
# every consecutive node pair is joined by the edge named on the earlier row.
query I
SELECT count(*) FROM (
  SELECT d.node, d.edge, lead(d.node) OVER (ORDER BY d.seq) AS next_node
  FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 12, 7, false) d
) p JOIN edges e ON e.id = p.edge
WHERE p.next_node IS NOT NULL
  AND NOT ((e.source = p.node AND e.target = p.next_node) OR (e.target = p.node AND e.source = p.next_node));
----
0

# `directed => false` is pgRouting's own spelling and must match the positional form.
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 6, 10, directed => false);
----
1	1	6	10	6	2	1	0
2	2	6	10	10	-1	0	1

# ---------------------------------------------------------------------------
# cost only: reverse_cost is absent, so every edge becomes strictly one-way
# ---------------------------------------------------------------------------

# pgRouting q11: 10 has no incoming edge at all once reverse_cost is gone.
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM edges', 6, 10);
----

# pgRouting q111: 6 -> 7 still works
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM edges', 6, 7);
----
1	1	6	7	6	4	1	0
2	2	6	7	7	-1	0	1

# pgRouting q112: 12 -> 10 unreachable
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM edges', 12, 10);
----

# pgRouting q113: 12 -> 7 unreachable
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM edges', 12, 7);
----

# pgRouting q13: 6 -> 10 undirected, cost only
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM edges', 6, 10, false);
----
1	1	6	10	6	4	1	0
2	2	6	10	7	8	1	1
3	3	6	10	11	5	1	2
4	4	6	10	10	-1	0	3

# pgRouting q132: 12 -> 10 undirected, cost only
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM edges', 12, 10, false);
----
1	1	12	10	12	11	1	0
2	2	12	10	11	5	1	1
3	3	12	10	10	-1	0	2

# pgRouting q133: 12 -> 7 undirected, cost only.
# KNOWN TIE, same shape as q93 above: 12->8->7 and 12->11->7 both cost 2.
query IIIR
SELECT count(*), min(start_vid), min(end_vid), max(agg_cost)
FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM edges', 12, 7, false);
----
3	12	7	2

# ---------------------------------------------------------------------------
# Degenerate graphs, from pgtap edge_cases/zero_one_edge_no_reverse.pg
# ---------------------------------------------------------------------------

# Zero edges: every query is empty rather than an error.
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM edges WHERE id > 18', 7, 11);
----

query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM edges WHERE id > 18', 11, 7, false);
----

# A single edge 11->16 cannot serve a 7->11 request in either orientation.
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM edges WHERE id = 9', 7, 11);
----

query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM edges WHERE id = 9', 11, 7);
----

query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM edges WHERE id = 9', 7, 11, false);
----

query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM edges WHERE id = 9', 11, 7, false);
----

# The single edge itself routes fine.
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM edges WHERE id = 9', 11, 16);
----
1	1	11	16	11	9	1	0
2	2	11	16	16	-1	0	1

# ---------------------------------------------------------------------------
# Endpoints that are missing or coincide
# ---------------------------------------------------------------------------

# pgRouting reports a coincident start/end as zero rows, not a zero-length path.
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 6, 6);
----

# A vertex that does not exist in the graph is empty, not an error.
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 6, 9999);
----

query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 9999, 6);
----

# Disconnected component: 13->14 is its own island.
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 6, 14);
----

# ---------------------------------------------------------------------------
# Input validation
# ---------------------------------------------------------------------------

statement error
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target FROM edges', 6, 10);
----
must expose a 'cost' column

statement error
SELECT * FROM duckrouting_dijkstra('SELECT id AS wrong, source, target, cost FROM edges', 6, 10);
----
must expose a 'id' column

statement error
SELECT * FROM duckrouting_dijkstra('NOT VALID SQL', 6, 10);
----
could not prepare the edges query

# A NULL reverse_cost means "no reverse edge", exactly like a negative one.
statement ok
CREATE TABLE nulled AS SELECT id, source, target, cost, CASE WHEN reverse_cost < 0 THEN NULL ELSE reverse_cost END AS reverse_cost FROM edges;

# Same known tie as q93; assert the determinate part. What matters here is that
# NULL and -1 produce the identical graph.
query IIIR
SELECT count(*), min(start_vid), min(end_vid), max(agg_cost)
FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM nulled', 12, 7, false);
----
3	12	7	2

# NULL-as-reverse_cost and -1-as-reverse_cost must agree row for row.
query I
SELECT count(*) FROM (
  SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM nulled', 6, 10)
  EXCEPT
  SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 6, 10)
);
----
0

# ---------------------------------------------------------------------------
# Infinite edge cost, from pgtap/dijkstra/dijkstra/edge_cases/infinity_cost.pg
# ---------------------------------------------------------------------------
# Boost will not relax an edge whose weight is a true infinity, because the
# relaxation test `dist[u] + w < dist[v]` becomes `inf < inf`. pgRouting works
# around this by storing Infinity as DBL_MAX on ingest and mapping it back on
# output; duckrouting does the same, so a route through an infinite edge is
# still reported, at an infinite cost.

statement ok
CREATE TABLE inf_edges AS SELECT * FROM edges;

statement ok
UPDATE inf_edges SET cost = 'Infinity' WHERE id = 7;

# pgRouting q0: before the change, 1 -> 11 costs 3.
query R
SELECT max(agg_cost) FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM edges', 1, 11);
----
3

# pgRouting q1: a route avoiding edge 7 is unaffected.
query R
SELECT max(agg_cost) FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM inf_edges', 1, 3);
----
1

# pgRouting q2: 3 -> 7 goes through the infinite edge and still returns a path.
query IIIIIIRR
SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM inf_edges', 3, 7);
----
1	1	3	7	3	7	inf	0
2	2	3	7	7	-1	0	inf

# pgRouting q4 and q6: any route crossing edge 7 aggregates to Infinity.
query R
SELECT max(agg_cost) FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM inf_edges', 1, 7);
----
inf

query R
SELECT max(agg_cost) FROM duckrouting_dijkstra('SELECT id, source, target, cost FROM inf_edges', 1, 11);
----
inf

# ---------------------------------------------------------------------------
# Many-to-many, from pgRouting docqueries q7
# ---------------------------------------------------------------------------
# Every ordered pair from the list, minus the pairs whose endpoints coincide.
query I
SELECT count(*) FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', [7,10,15], [7,10,15]);
----
22

# Results are grouped by start_vid then end_vid, and repeated vertices in the
# input do not produce repeated output (pgRouting q6 passes 7,10,15,10,10,15).
query II
SELECT DISTINCT start_vid, end_vid
FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', [7,10,15,10,10,15], [10,7,10,15])
ORDER BY start_vid, end_vid;
----
7	10
7	15
10	7
10	15
15	7
15	10

# One-to-many and many-to-one agree with the scalar form (pgRouting q151-q153).
query I
SELECT count(*) FROM (
  SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 6, [10])
  EXCEPT
  SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 6, 10)
);
----
0

query I
SELECT count(*) FROM (
  SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', [6], [10])
  EXCEPT
  SELECT * FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', 6, 10)
);
----
0

# ---------------------------------------------------------------------------
# duckrouting_dijkstra_cost, from docqueries/dijkstra/dijkstraCost.result
# ---------------------------------------------------------------------------

# pgRouting q2: 6 -> 10 directed costs 5.
query IIR
SELECT * FROM duckrouting_dijkstra_cost('SELECT id, source, target, cost, reverse_cost FROM edges', 6, 10, true);
----
6	10	5

# The cost must equal the final agg_cost of the full path.
query I
SELECT count(*) FROM (
  SELECT start_vid, end_vid, agg_cost
  FROM duckrouting_dijkstra_cost('SELECT id, source, target, cost, reverse_cost FROM edges', [6,12], [7,10])
  EXCEPT
  SELECT start_vid, end_vid, max(agg_cost) OVER (PARTITION BY start_vid, end_vid)
  FROM duckrouting_dijkstra('SELECT id, source, target, cost, reverse_cost FROM edges', [6,12], [7,10])
);
----
0

# Unreachable pairs contribute no row at all.
query IIR
SELECT * FROM duckrouting_dijkstra_cost('SELECT id, source, target, cost FROM edges', 6, 10);
----

# ---------------------------------------------------------------------------
# duckrouting_dijkstra_cost_matrix
# ---------------------------------------------------------------------------

# Undirected over 4 vertices: 4*3 = 12 ordered pairs, all reachable here.
query I
SELECT count(*) FROM duckrouting_dijkstra_cost_matrix('SELECT id, source, target, cost, reverse_cost FROM edges', [5,6,10,15], false);
----
12

# An undirected matrix must be symmetric.
query I
SELECT count(*) FROM (
  SELECT a.start_vid, a.end_vid FROM
    duckrouting_dijkstra_cost_matrix('SELECT id, source, target, cost, reverse_cost FROM edges', [5,6,10,15], false) a
  JOIN
    duckrouting_dijkstra_cost_matrix('SELECT id, source, target, cost, reverse_cost FROM edges', [5,6,10,15], false) b
  ON a.start_vid = b.end_vid AND a.end_vid = b.start_vid
  WHERE a.agg_cost <> b.agg_cost
);
----
0

# The matrix is exactly the cost function applied to one list against itself.
query I
SELECT count(*) FROM (
  SELECT * FROM duckrouting_dijkstra_cost_matrix('SELECT id, source, target, cost, reverse_cost FROM edges', [5,6,10,15])
  EXCEPT
  SELECT * FROM duckrouting_dijkstra_cost('SELECT id, source, target, cost, reverse_cost FROM edges', [5,6,10,15], [5,6,10,15])
);
----
0

# ---------------------------------------------------------------------------
# duckrouting_driving_distance, from docqueries/driving_distance/
# ---------------------------------------------------------------------------

# pgRouting q5: everything within cost 3 of vertex 11 is a 13-node tree.
query I
SELECT count(*) FROM duckrouting_driving_distance('SELECT id, source, target, cost, reverse_cost FROM edges', 11, 3.0);
----
13

# The root row is depth 0, its own predecessor, edge -1, cost 0.
query IIIIRR
SELECT depth, start_vid, pred, edge, cost, agg_cost
FROM duckrouting_driving_distance('SELECT id, source, target, cost, reverse_cost FROM edges', 11, 3.0)
WHERE node = 11;
----
0	11	11	-1	0	0

# Depth counts hops and agg_cost never exceeds the limit.
query IIR
SELECT depth, count(*), max(agg_cost)
FROM duckrouting_driving_distance('SELECT id, source, target, cost, reverse_cost FROM edges', 11, 3.0)
GROUP BY depth ORDER BY depth;
----
0	1	0
1	3	1
2	5	2
3	4	3

# equicost assigns each node to whichever start reaches it most cheaply, so no
# node may appear twice.
query I
SELECT count(*) FROM (
  SELECT node FROM duckrouting_driving_distance('SELECT id, source, target, cost, reverse_cost FROM edges', [11,16], 3.0, equicost => true)
  GROUP BY node HAVING count(*) > 1
);
----
0

# Without equicost a node reachable from both starts is reported for both.
query I
SELECT count(*) > 0 FROM (
  SELECT node FROM duckrouting_driving_distance('SELECT id, source, target, cost, reverse_cost FROM edges', [11,16], 3.0)
  GROUP BY node HAVING count(*) > 1
);
----
true

# A zero radius reaches only the start vertex itself.
query I
SELECT count(*) FROM duckrouting_driving_distance('SELECT id, source, target, cost, reverse_cost FROM edges', 11, 0.0);
----
1
