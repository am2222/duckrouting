# name: test/sql/map_match.test
# description: map matching -- snapping noisy GPS points onto the graph
# group: [sql]

#
# The algorithm is Fast Map Matching (Yang & Gidofalvi, 2018): a hidden
# Markov model whose emission probability is a Gaussian on the distance from
# each GPS point to a candidate edge, and whose transition probability is the
# ratio of straight-line distance to shortest-path distance between
# consecutive candidates. Candidates are supplied as a query in the shape
# duckrouting_find_close_edges produces, so no geometry is needed here.
#
# The network, the three trips and the expected results are FMM's own sample
# data (example/data in https://github.com/cyang-kth/fmm, Apache-2.0). The
# cost of each edge is its length, which is what FMM routes on, and the
# candidate table is what FMM's search finds with k = 4 and radius = 0.4.

require duckrouting

statement ok
CREATE TABLE edges(id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
 (1,1,2,1.0,-1),(2,2,1,1.0,-1),(3,3,1,1.0,-1),(4,4,3,1.0,-1),(5,1,5,1.0,-1),(6,5,1,1.0,-1),
 (7,3,6,1.0,-1),(8,7,8,1.0,-1),(9,8,7,1.0,-1),(10,5,8,1.0,-1),(11,8,5,1.0,-1),(12,6,5,1.0,-1),
 (13,5,6,1.0,-1),(14,6,9,1.0,-1),(15,9,6,1.0,-1),(16,10,5,1.0,-1),(17,5,10,1.0,-1),(18,6,11,1.0,-1),
 (19,10,11,1.0,-1),(20,11,12,1.0,-1),(21,13,10,1.0,-1),(22,10,13,1.0,-1),(23,9,12,1.0,-1),(24,12,9,1.0,-1),
 (25,9,4,1.0,-1),(26,4,9,1.0,-1),(27,14,15,1.5,-1),(28,15,14,1.5,-1),(29,16,17,1.7,-1),(30,17,16,1.7,-1);

statement ok
CREATE TABLE candidates(traj_id BIGINT, pid BIGINT, edge_id BIGINT, fraction DOUBLE, distance DOUBLE, x DOUBLE, y DOUBLE);

