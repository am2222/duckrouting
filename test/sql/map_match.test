# ---------------------------------------------------------------------------
# duckrouting_map_match: one row per GPS point, the edge it was matched to
# ---------------------------------------------------------------------------
# FMM's mr.txt reports cpath 2,5,13,14,23 for trip 1, 25,4,3,5,17,19 for
# trip 2 and 8,11,13,18,20,24 for trip 3. The matched edge per point is that
# path with the connecting edges (5 in trip 1, 13 in trip 3) removed.

query III
SELECT traj_id, pid, edge FROM duckrouting_map_match(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT traj_id, pid, edge_id, fraction, distance, x, y FROM candidates', 0.5)
ORDER BY traj_id, pid;
----
1	1	2
1	2	2
1	3	13
1	4	14
1	5	23
2	1	25
2	2	4
2	3	3
2	4	5
2	5	17
2	6	19
3	1	8
3	2	11
3	3	18
3	4	18
3	5	20
3	6	24

# The matched fraction and distance are those of the chosen candidate.
query RR
SELECT round(fraction, 6), round(distance, 6) FROM duckrouting_map_match(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT traj_id, pid, edge_id, fraction, distance, x, y FROM candidates', 0.5)
WHERE traj_id = 1 AND pid = 1;
----
0.250989	0.341102

# Emission probability is exp(-0.5 * (distance / gps_error)^2); the first
# point has no transition, so tp and sp_dist are 0 there. From point 2 to
# point 3 the route runs 0.298 to the end of edge 2, all of edge 5 and 0.493
# into edge 13, further than the straight line between the fixes, so tp < 1.

query IRRR
SELECT pid, round(ep, 6), round(tp, 6), round(sp_dist, 6) FROM duckrouting_map_match(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT traj_id, pid, edge_id, fraction, distance, x, y FROM candidates', 0.5)
WHERE traj_id = 1 ORDER BY pid;
----
1	0.792391	0	0
2	0.788102	1	0.450847
3	0.896001	0.756067	1.791525
4	0.975345	1	1.055932
5	0.966437	0.895804	0.908475

# gps_error is a named parameter too, and defaults to 50.
query I
SELECT count(*) FROM duckrouting_map_match(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT traj_id, pid, edge_id, fraction, distance, x, y FROM candidates', gps_error => 0.5);
----
17

query I
SELECT count(*) FROM duckrouting_map_match(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT traj_id, pid, edge_id, fraction, distance, x, y FROM candidates');
----
17

# Without a traj_id column every candidate belongs to trajectory 1.
query II
SELECT traj_id, edge FROM duckrouting_map_match(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT pid, edge_id, fraction, distance, x, y FROM candidates WHERE traj_id = 2', 0.5)
ORDER BY pid;
----
1	25
1	4
1	3
1	5
1	17
1	19

# ---------------------------------------------------------------------------
# duckrouting_map_match_path: the complete route through the network
# ---------------------------------------------------------------------------
# The edge sequence is FMM's cpath exactly. Two consecutive points on the same
# edge (trip 1 points 1 and 2, trip 3 points 3 and 4) produce one row, since
# the intermediate point vertex is hidden and its segment merged.

query II
SELECT path_id, list(edge ORDER BY path_seq) FILTER (WHERE edge <> -1) FROM duckrouting_map_match_path(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT traj_id, pid, edge_id, fraction, distance, x, y FROM candidates', 0.5)
GROUP BY path_id ORDER BY path_id;
----
1	[2, 5, 13, 14, 23]
2	[25, 4, 3, 5, 17, 19]
3	[8, 11, 13, 18, 20, 24]

# Trip 1 in full. It starts at point -1 and ends at point -5; the first row's
# cost covers the rest of edge 2 beyond point 2, whose vertex is hidden. The
# total is the length of FMM's matched geometry
# LINESTRING(2 0.250988700565,2 1,2 2,3 2,4 2,4 2.45776836158).

query IIIIIRR
SELECT path_seq, start_vid, end_vid, node, edge, round(cost, 6), round(agg_cost, 6) FROM duckrouting_map_match_path(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT traj_id, pid, edge_id, fraction, distance, x, y FROM candidates', 0.5)
WHERE path_id = 1 ORDER BY path_seq;
----
1	-1	-5	-1	2	0.749011	0
2	-1	-5	1	5	1	0.749011
3	-1	-5	5	13	1	1.749011
4	-1	-5	6	14	1	2.749011
5	-1	-5	9	23	0.457768	3.749011
6	-1	-5	-5	-1	0	4.20678

# With details every matched point appears as its own vertex, splitting the
# edge it sits on at its fraction.
query IIR
SELECT node, edge, round(cost, 6) FROM duckrouting_map_match_path(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT traj_id, pid, edge_id, fraction, distance, x, y FROM candidates', 0.5, details => true)
WHERE path_id = 1 ORDER BY path_seq;
----
-1	2	0.450847
-2	2	0.298164
1	5	1
5	13	0.493362
-3	13	0.506638
6	14	0.549294
-4	14	0.450706
9	23	0.457768
-5	-1	0

# ---------------------------------------------------------------------------
# Unmatched trajectories
# ---------------------------------------------------------------------------
# Edge 27 is on a disconnected piece of the network, so no transition from it
# exists and the trajectory is reported unmatched, as FMM does: no rows.

statement ok
CREATE TABLE stranded(pid BIGINT, edge_id BIGINT, fraction DOUBLE, distance DOUBLE, x DOUBLE, y DOUBLE);

statement ok
INSERT INTO stranded VALUES (1, 27, 0.5, 0.1, 1.25, 3.4), (2, 5, 0.5, 0.1, 2.1, 1.5);

query I
SELECT count(*) FROM duckrouting_map_match(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT pid, edge_id, fraction, distance, x, y FROM stranded', 0.5);
----
0

query I
SELECT count(*) FROM duckrouting_map_match_path(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT pid, edge_id, fraction, distance, x, y FROM stranded', 0.5);
----
0

# delta bounds the shortest-path search between consecutive points, which is
# FMM's upper bound. Trip 1 needs a transition of 1.79 and trip 3 one of
# 1.72, so a bound of 1.5 breaks both, while trip 2's longest is 1.13.

query I
SELECT list(DISTINCT traj_id ORDER BY traj_id) FROM duckrouting_map_match(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT traj_id, pid, edge_id, fraction, distance, x, y FROM candidates', 0.5, delta => 1.5);
----
[2]

query I
SELECT list(DISTINCT traj_id ORDER BY traj_id) FROM duckrouting_map_match(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT traj_id, pid, edge_id, fraction, distance, x, y FROM candidates', 0.5, delta => 1.8);
----
[1, 2, 3]

# A single point is trivially matched to its closest candidate.
query II
SELECT pid, edge FROM duckrouting_map_match(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT pid, edge_id, fraction, distance, x, y FROM candidates WHERE traj_id = 3 AND pid = 3', 0.5);
----
3	18

# ---------------------------------------------------------------------------
# reverse_tolerance
# ---------------------------------------------------------------------------
# Two fixes on the same one-way edge, the second slightly behind the first.
# By default the only way to get there is round the block; with a tolerance
# of 0.1 (a tenth of the edge) the step back is treated as GPS noise instead.

statement ok
CREATE TABLE backwards(pid BIGINT, edge_id BIGINT, fraction DOUBLE, distance DOUBLE, x DOUBLE, y DOUBLE);

statement ok
INSERT INTO backwards VALUES (1, 5, 0.6, 0.05, 2.05, 1.6), (2, 5, 0.55, 0.05, 2.05, 1.55);

query IR
SELECT pid, round(sp_dist, 6) FROM duckrouting_map_match(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT pid, edge_id, fraction, distance, x, y FROM backwards', 0.5)
ORDER BY pid;
----
1	0
2	1.95

query IR
SELECT pid, round(sp_dist, 6) FROM duckrouting_map_match(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT pid, edge_id, fraction, distance, x, y FROM backwards', 0.5, reverse_tolerance => 0.1)
ORDER BY pid;
----
1	0
2	0

query I
SELECT list(edge ORDER BY path_seq) FILTER (WHERE edge <> -1) FROM duckrouting_map_match_path(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT pid, edge_id, fraction, distance, x, y FROM backwards', 0.5, reverse_tolerance => 0.1);
----
[5]

